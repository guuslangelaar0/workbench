#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
os="${WORKBENCH_MESH_TEST_OS:-$(uname -s)}"
arch="${WORKBENCH_MESH_TEST_ARCH:-$(uname -m)}"
case "$os:$arch" in
  Darwin:arm64)  target="aarch64-apple-darwin"; platform="macos-arm64" ;;
  Darwin:x86_64) target="x86_64-apple-darwin"; platform="macos-x64" ;;
  Linux:aarch64|Linux:arm64) target="aarch64-unknown-linux-gnu"; platform="linux-arm64" ;;
  Linux:x86_64) target="x86_64-unknown-linux-gnu"; platform="linux-x64" ;;
  *) echo "workbench-mesh: unsupported platform $os/$arch" >&2; exit 70 ;;
esac

read_plugin_version() {
  local manifest="$1"
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$manifest" <<'PY' 2>/dev/null && return 0
import json
import sys

with open(sys.argv[1]) as f:
    version = json.load(f).get("version", "")
if isinstance(version, str) and version:
    print(version)
else:
    sys.exit(1)
PY
  fi
  sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$manifest" | head -1
}

version="$(read_plugin_version "$ROOT/.claude-plugin/plugin.json" || true)"
[ -n "$version" ] || { echo "workbench-mesh: could not read plugin version" >&2; exit 69; }

bundled="$ROOT/bin/workbench-mesh.d/$target/workbench-mesh"
if [ -x "$bundled" ]; then
  exec "$bundled" "$@"
fi

# The verified-binary cache lives in workbench's OWN plugin data dir. A
# session's Bash tool does not get CLAUDE_PLUGIN_DATA at all, and can inherit
# another plugin's, so: trust the variable only when it names a workbench data
# dir, then look under the active config dir's plugins/data/workbench-*.
config_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
is_workbench_data_dir() {
  case "$(basename "$1")" in
    workbench|workbench-*) return 0 ;;
    *) return 1 ;;
  esac
}
data_dir=""
if [ -n "${CLAUDE_PLUGIN_DATA:-}" ] && is_workbench_data_dir "$CLAUDE_PLUGIN_DATA"; then
  data_dir="${CLAUDE_PLUGIN_DATA%/}"
  cached="$data_dir/mesh/bin/$version/$platform/workbench-mesh"
  if [ -x "$cached" ]; then
    exec "$cached" "$@"
  fi
fi
for candidate in "$config_dir"/plugins/data/workbench-*/ "$config_dir"/plugins/data/workbench/; do
  [ -d "$candidate" ] || continue
  candidate="${candidate%/}"
  [ -n "$data_dir" ] || data_dir="$candidate"
  cached="$candidate/mesh/bin/$version/$platform/workbench-mesh"
  if [ -x "$cached" ]; then
    exec "$cached" "$@"
  fi
done

if [ -x "$ROOT/target/release/workbench-mesh" ]; then
  exec "$ROOT/target/release/workbench-mesh" "$@"
fi
if [ -x "$ROOT/target/debug/workbench-mesh" ]; then
  exec "$ROOT/target/debug/workbench-mesh" "$@"
fi

# Nothing cached: bootstrap into workbench's data dir (never another plugin's).
[ -n "$data_dir" ] || data_dir="$config_dir/plugins/data/workbench-workbench"
WORKBENCH_MESH_DATA_DIR="$data_dir" exec "$ROOT/scripts/mesh-bootstrap.sh" "$platform" "$target" "$version" "$@"
